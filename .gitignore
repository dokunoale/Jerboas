# MovieLens may not be redistributed: "The user may not redistribute the data
# without separate permission" (GroupLens usage licence), and the IMDb-derived
# files are non-commercial-use only. So everything under data/ stays local
# except the synthetic example graph and the scripts that build the rest.
data/**
!data/**/
!data/example/**
!data/**/*.py

